            "primary_network_interface": [
              {
                "delete_on_termination": true,
                "network_interface_id": "eni-0ee1ff13347da52ce"
              }
            ],
            "primary_network_interface_id": "eni-0ee1ff13347da52ce",
            "private_dns": "ip-10-100-101-218.ap-northeast-1.compute.internal",
            "private_dns_name_options": [
              {
                "enable_resource_name_dns_a_record": false,
                "enable_resource_name_dns_aaaa_record": false,
                "hostname_type": "ip-name"
              }
            ],
            "private_ip": "10.100.101.218",
            "public_dns": "",
